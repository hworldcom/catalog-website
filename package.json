{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "ci:node22": "npx -y -p node@22.13.0 -p npm@10.9.2 npm ci",
    "preinstall": "node ./scripts/check-node-version.cjs",
    "postinstall": "node ./scripts/check-rolldown-binding.cjs",
    "predev": "node ./scripts/check-node-version.cjs",
    "dev": "vite dev",
    "dev:node22": "npx -y -p node@22.13.0 -p npm@10.9.2 npm run dev --",
    "prebuild": "node ./scripts/check-node-version.cjs",
    "build": "vite build && node ./scripts/build-runtime-commands.mjs",
    "build:node22": "npx -y -p node@22.13.0 -p npm@10.9.2 npm run build",
    "build:dev": "vite build --mode development",
    "prestart:web": "node ./scripts/check-node-version.cjs",
    "start:web": "node ./.output/commands/web-process.mjs",
    "prestart:product-activation-worker": "node ./scripts/check-node-version.cjs",
    "start:product-activation-worker": "node ./.output/commands/product-activation-worker.mjs",
    "prestart:product-activation-reconciliation": "node ./scripts/check-node-version.cjs",
    "start:product-activation-reconciliation": "node ./.output/commands/product-activation-reconciliation.mjs",
    "prepreview": "node ./scripts/check-node-version.cjs",
    "preview": "vite preview",
    "prelint": "node ./scripts/check-node-version.cjs",
    "lint": "eslint .",
    "lint:node22": "npx -y -p node@22.13.0 -p npm@10.9.2 npm run lint",
    "pretest": "node ./scripts/check-node-version.cjs",
    "test": "vitest run",
    "test:node22": "npx -y -p node@22.13.0 -p npm@10.9.2 npm run test",
    "test:watch": "vitest",
    "test:watch:node22": "npx -y -p node@22.13.0 -p npm@10.9.2 npm run test:watch --",
    "preworker:classifier-import": "node ./scripts/check-node-version.cjs",
    "worker:classifier-import": "tsx src/features/admin/server/classifier-import.worker-process.ts",
    "preworker:product-activation": "node ./scripts/check-node-version.cjs",
    "worker:product-activation": "tsx src/features/admin/server/product-activation.worker-process.ts",
    "prereconcile:product-activation-dispatches": "node ./scripts/check-node-version.cjs",
    "reconcile:product-activation-dispatches": "tsx src/features/admin/server/product-activation-reconciliation.command.ts",
    "prereconcile:product-draft-images": "node ./scripts/check-node-version.cjs",
    "reconcile:product-draft-images": "tsx src/features/admin/server/legacy-product-draft-image-cutover.command.ts",
    "prereset:product-data": "node ./scripts/check-node-version.cjs",
    "reset:product-data": "tsx src/features/admin/server/product-data-reset.command.ts",
    "prereset:uat-marketplace-fixtures": "node ./scripts/check-node-version.cjs",
    "reset:uat-marketplace-fixtures": "tsx --env-file=.env src/features/admin/server/uat-marketplace-fixtures.command.ts reset",
    "preseed:uat-marketplace-fixtures": "node ./scripts/check-node-version.cjs",
    "seed:uat-marketplace-fixtures": "tsx --env-file=.env src/features/admin/server/uat-marketplace-fixtures.command.ts seed",
    "preverify:uat-marketplace-fixtures": "node ./scripts/check-node-version.cjs",
    "verify:uat-marketplace-fixtures": "tsx --env-file=.env src/features/admin/server/uat-marketplace-fixtures.command.ts verify",
    "preflight:uat-marketplace-fixtures-workflow": "tsx src/features/admin/server/uat-marketplace-fixtures.workflow-command.ts preflight",
    "summarize:uat-marketplace-fixtures-workflow": "tsx src/features/admin/server/uat-marketplace-fixtures.workflow-command.ts summary",
    "preqa:description-generation-provider": "node ./scripts/check-node-version.cjs",
    "qa:description-generation-provider": "tsx --env-file=.env src/features/product-draft-description-generation/server/product-draft-description-generation-provider.command.ts",
    "preqa:container-runtime": "node ./scripts/check-node-version.cjs",
    "qa:container-runtime": "node ./scripts/qa-container-runtime.mjs",
    "infra:foundation:check": "node ./scripts/terraform/foundation-contract.mjs && node ./scripts/terraform/identity-contract.mjs && node ./scripts/terraform/secret-contract.mjs && node ./scripts/terraform/artifact-contract.mjs && node ./scripts/terraform/runtime-contract.mjs",
    "infra:foundation:plan:check": "node ./scripts/terraform/foundation-plan-contract.mjs",
    "infra:identity:check": "node ./scripts/terraform/identity-contract.mjs",
    "infra:artifact:check": "node ./scripts/terraform/artifact-contract.mjs",
    "infra:runtime:check": "node ./scripts/terraform/runtime-contract.mjs",
    "infra:terraform:validate": "bash ./scripts/terraform/validate-foundation.sh",
    "supabase:start": "node ./scripts/supabase/local-command.mjs start",
    "db:local:reset": "node ./scripts/supabase/local-command.mjs reset",
    "db:local:test": "node ./scripts/supabase/local-command.mjs test",
    "db:local:verify": "node ./scripts/supabase/local-command.mjs verify",
    "db:types:generate": "node ./scripts/supabase/types-command.mjs generate",
    "db:types:check": "node ./scripts/supabase/types-command.mjs check",
    "db:environment:preflight": "node ./scripts/supabase/environment-command.mjs preflight",
    "db:environment:assert-current": "node ./scripts/supabase/environment-command.mjs assert-current",
    "db:environment:migrate": "node ./scripts/supabase/environment-command.mjs migrate",
    "db:environment:verify": "node ./scripts/supabase/deployment-command.mjs verify",
    "db:environment:storage-smoke": "node ./scripts/supabase/deployment-command.mjs storage-smoke",
    "format": "prettier --write ."
  },
