# Copy to .env.supabase.uat.local at the repository root and fill in real UAT values.
BAZORIA_SUPABASE_PROJECT_REF=
SUPABASE_URL=
BAZORIA_SUPABASE_DATABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Non-secret deployment inventory values from the Supabase dashboard.
BAZORIA_SUPABASE_ORGANIZATION_ID=
BAZORIA_SUPABASE_PLAN=
BAZORIA_SUPABASE_MANAGED_BACKUPS=
BAZORIA_SUPABASE_BACKUP_RETENTION=
BAZORIA_SUPABASE_POINT_IN_TIME_RECOVERY=

# Add the confirmed UAT administrator UUID after the account is created.
BAZORIA_PROTOTYPE_ADMIN_USER_IDS=
