# Browser-safe hosted UAT Supabase settings.
VITE_SUPABASE_URL=https://jhkouuxouplqcfecjutd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase settings. Never expose the service-role key through VITE_.
SUPABASE_URL=https://jhkouuxouplqcfecjutd.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local classifier server boundary.
BAZORIA_CLASSIFIER_API_BASE_URL=http://localhost:8000
BAZORIA_DEFAULT_CLASSIFIER_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
BAZORIA_CLASSIFIER_IMPORT_DISPATCH_MODE=local

# UAT seller and administrator identifiers are provisioned by the project owner.
BAZORIA_DEFAULT_SELLER_ID=
BAZORIA_PROTOTYPE_ADMIN_USER_IDS=
BAZORIA_ADMIN_PRODUCT_DRAFTS_ENABLED=true

# Server-only multilingual ProductDraft description generation.
OPENAI_API_KEY=
BAZORIA_DESCRIPTION_GENERATION_MODEL=gpt-5.4-nano

# Local product publication is dispatched by the Bazoria server process.
BAZORIA_PRODUCT_PUBLICATION_DISPATCH_MODE=local
