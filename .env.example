# Runtime Supabase settings. Use the project assigned to the selected deployment
# environment. The publishable key is exposed only through the validated
# /api/runtime-config response; the service-role key remains server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# UAT seller and administrator identifiers are provisioned by the project owner.
BAZORIA_PROTOTYPE_ADMIN_USER_IDS=
BAZORIA_ADMIN_PRODUCT_DRAFTS_ENABLED=true

# Legacy marketplace fixture settings remain unused until ticket 0038d replaces
# the retired fixture command. Keep these server-only and unset in deployments.
BAZORIA_ALLOW_UAT_FIXTURE_RESET=false
BAZORIA_UAT_DATABASE_URL=
BAZORIA_UAT_FIXTURE_ASSET_DIR=.uat-fixtures/0039c1

# Server-only multilingual ProductDraft description generation.
OPENAI_API_KEY=
BAZORIA_DESCRIPTION_GENERATION_MODEL=gpt-5.4-nano

# Bazoria environment identity is independent of NODE_ENV. Classifier-assisted
# upload defaults to disabled locally and must be explicitly false in UAT and
# production.
BAZORIA_DEPLOYMENT_ENVIRONMENT=local
BAZORIA_CLASSIFIER_ASSISTED_UPLOAD_ENABLED=false
BAZORIA_GOOGLE_SIGN_IN_ENABLED=false

# Optional local classifier server boundary. These values are read only when
# BAZORIA_CLASSIFIER_ASSISTED_UPLOAD_ENABLED=true. Do not configure classifier
# integration values in UAT or production for this release.
BAZORIA_CLASSIFIER_API_BASE_URL=http://localhost:8000
BAZORIA_DEFAULT_CLASSIFIER_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
BAZORIA_CLASSIFIER_IMPORT_DISPATCH_MODE=local

# Public root origin used for canonical links, social preview metadata, and
# authentication callbacks.
BAZORIA_PUBLIC_SITE_URL=http://localhost:8080

# Local product publication is dispatched by the Bazoria server process.
BAZORIA_PRODUCT_PUBLICATION_DISPATCH_MODE=local

# Required when dispatch mode is cloud_tasks.
GOOGLE_CLOUD_PROJECT=
BAZORIA_PRODUCT_PUBLICATION_TASK_LOCATION=
BAZORIA_PRODUCT_PUBLICATION_TASK_QUEUE=
BAZORIA_PRODUCT_PUBLICATION_WORKER_URL=
BAZORIA_PRODUCT_PUBLICATION_TASK_SERVICE_ACCOUNT=
BAZORIA_PRODUCT_PUBLICATION_TASK_AUDIENCE=
BAZORIA_PRODUCT_PUBLICATION_TASK_DISPATCH_DEADLINE_SECONDS=270
BAZORIA_PRODUCT_PUBLICATION_TASK_CLIENT_TIMEOUT_SECONDS=10
BAZORIA_PRODUCT_PUBLICATION_TASK_MAX_RETRY_DURATION_SECONDS=420

# Required by the deployed bounded pending-dispatch reconciliation job.
BAZORIA_PRODUCT_ACTIVATION_RECONCILIATION_BATCH_SIZE=100
BAZORIA_PRODUCT_ACTIVATION_RECONCILIATION_DEADLINE_SECONDS=60

# Read by the private product-activation worker service. The audience and
# service account must exactly match the values used by Cloud Tasks above.
# PORT defaults to 8080 when it is omitted outside Cloud Run.
PORT=8080
